APP_NAME=MarcatursHub
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=null
LOG_LEVEL=debug

# Isolated from development and production data.
# phpunit.xml forces sqlite :memory: unless these are overridden.
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=array
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
SANCTUM_TOKEN_EXPIRATION_MINUTES=10080
