APP_NAME=MarcatursHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=marcaturshub
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
VERIFICATION_EVIDENCE_DISK=sensitive
# VERIFICATION_MAX_EVIDENCE_KB=5120
# VERIFICATION_RETENTION_DAYS=
CAMPAIGN_FREE_LISTING_DAYS=30
CAMPAIGN_EXPIRING_LEAD_DAYS=0
CAMPAIGN_MEDIA_DISK=campaign_media
CAMPAIGN_RESOURCE_MAX_FILE_KB=20480
DEAL_PAYMENT_EVIDENCE_DISK=sensitive
# DEAL_PAYMENT_EVIDENCE_MAX_KB=5120
# DEAL_PAYMENT_EVIDENCE_RETENTION_DAYS=
# DEAL_COMMISSION_PAYMENT_CEILING_DAYS=7

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=

QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=
REDIS_PORT=6379

# Local Reverb (MH-BE-013). Placeholders only — not production credentials.
# Start with: php artisan reverb:start
# Chat broadcast is synchronous after DB commit; no extra queue worker is required for messages.
REVERB_APP_ID=marcaturshub-local
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Production WebSocket/ALB topology is not settled. Do not treat these as production values.

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,::1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

API_VERSION=v1
API_RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=5
REGISTRATION_RATE_LIMIT_PER_MINUTE=5
PASSWORD_RESET_RATE_LIMIT_PER_MINUTE=5
UPLOAD_RATE_LIMIT_PER_MINUTE=10
API_PAGINATION_DEFAULT=15
API_PAGINATION_MAX=100
CHAT_MESSAGE_MAX_CHARS=5000
