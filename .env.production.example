APP_NAME=MarcatursHub
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=
FRONTEND_URL=
ADMIN_URL=

LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=marcaturshub
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=redis
CACHE_STORE=redis
FILESYSTEM_DISK=s3

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Required. Hosts or full origins (normalized to hosts). Never use *.
# Empty = fail-closed (MH-BE-050).
REVERB_ALLOWED_ORIGINS=

SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000

REDIS_CLIENT=phpredis
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379

# Prefer IAM task roles in ECS; leave keys empty when using instance/task roles.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=
SENSITIVE_DISK_DRIVER=s3
CAMPAIGN_MEDIA_DISK_DRIVER=s3
SENSITIVE_AWS_BUCKET=
CAMPAIGN_MEDIA_AWS_BUCKET=
SENSITIVE_S3_ROOT=sensitive
CAMPAIGN_MEDIA_S3_ROOT=campaign-media

SANCTUM_STATEFUL_DOMAINS=
SANCTUM_TOKEN_EXPIRATION_MINUTES=10080
CORS_ALLOWED_ORIGINS=

API_RATE_LIMIT_PER_MINUTE=60

# Live keys only after staging payment UAT is GREEN. Never copy staging secrets here.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

CAMPAIGN_MEDIA_DISK=campaign_media
VERIFICATION_EVIDENCE_DISK=sensitive
DEAL_PAYMENT_EVIDENCE_DISK=sensitive

# true only on a single controlled release task
RUN_MIGRATIONS=false
