APP_NAME=MarcatursHub
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
FRONTEND_URL=https://app.example.com

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=info
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=marcaturshub
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=

QUEUE_CONNECTION=redis
CACHE_STORE=redis
FILESYSTEM_DISK=s3

# Production WebSocket/ALB topology is pending architecture decision (MH-BE-012/013).
# Leave broadcasting disabled until that decision is implemented.
BROADCAST_CONNECTION=null
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=443
REVERB_SCHEME=https

REDIS_CLIENT=phpredis
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=

SANCTUM_STATEFUL_DOMAINS=
CORS_ALLOWED_ORIGINS=

API_RATE_LIMIT_PER_MINUTE=60

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=
