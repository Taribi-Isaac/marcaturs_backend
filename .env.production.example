############################################
# MarcatursHub — PRODUCTION environment template (MH-OPS-006)
#
# Pilot architecture: Lightsail (Nginx + PHP-FPM 8.4 + Redis + queue worker +
# scheduler + Reverb) with Lightsail Managed MySQL, private S3, Resend, Paystack.
# Contract: docs/deployment/production-environment.md
#
# Copy to /var/www/marcaturshub/shared/.env on the Lightsail host (mode 0640,
# owner deploy:www-data). NEVER commit a filled copy. Blank values are secrets or
# values that only exist after provisioning — do not invent them.
############################################

APP_NAME=MarcatursHub
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.marcaturshub.com.ng
FRONTEND_URL=https://app.marcaturshub.com.ng
# Staff invitation links (falls back to FRONTEND_URL when unset — must be set).
# Also the only Origin accepted for browser /api/v1/admin/* requests, cookie or
# Bearer (Option A, MH-SEC-001); override with ADMIN_ALLOWED_ORIGINS only if Admin moves.
ADMIN_FRONTEND_URL=https://admin.marcaturshub.com.ng
ADMIN_URL=https://admin.marcaturshub.com.ng

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# Lightsail Managed MySQL 8 (private endpoint, same region). TLS via the AWS RDS CA bundle.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=marcaturshub
DB_USERNAME=
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/aws-rds-global-bundle.pem

# Cookies are shared by app.* and admin.* through the parent domain (Sanctum SPA auth).
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.marcaturshub.com.ng
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=redis
CACHE_STORE=redis
BROADCAST_CONNECTION=reverb

# Redis runs on the app host, bound to 127.0.0.1 with requirepass.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# Laravel Reverb. Public endpoint wss://ws.marcaturshub.com.ng (Nginx :443 → 127.0.0.1:8080).
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=ws.marcaturshub.com.ng
REVERB_PORT=443
REVERB_SCHEME=https
# Bind to loopback only; never expose 8080 publicly.
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
# Explicit browser origins only. Never *. Empty = fail-closed (MH-BE-050).
# Admin has no realtime client; add admin.marcaturshub.com.ng only if that changes.
REVERB_ALLOWED_ORIGINS=app.marcaturshub.com.ng
REVERB_SCALING_ENABLED=false

SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000

# Private S3. Lightsail instances cannot assume IAM roles: use a dedicated IAM user
# limited to the two buckets below.
FILESYSTEM_DISK=local
SENSITIVE_DISK_DRIVER=s3
CAMPAIGN_MEDIA_DISK_DRIVER=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-north-1
SENSITIVE_AWS_BUCKET=
CAMPAIGN_MEDIA_AWS_BUCKET=
SENSITIVE_S3_ROOT=sensitive
CAMPAIGN_MEDIA_S3_ROOT=campaign-media
AWS_USE_PATH_STYLE_ENDPOINT=false

CAMPAIGN_MEDIA_DISK=campaign_media
VERIFICATION_EVIDENCE_DISK=sensitive
DEAL_PAYMENT_EVIDENCE_DISK=sensitive

SANCTUM_STATEFUL_DOMAINS=app.marcaturshub.com.ng,admin.marcaturshub.com.ng
SANCTUM_TOKEN_EXPIRATION_MINUTES=10080
CORS_ALLOWED_ORIGINS=https://app.marcaturshub.com.ng,https://admin.marcaturshub.com.ng

API_VERSION=v1
API_RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=5
REGISTRATION_RATE_LIMIT_PER_MINUTE=5
PASSWORD_RESET_RATE_LIMIT_PER_MINUTE=5
EMAIL_VERIFICATION_RATE_LIMIT_PER_MINUTE=5
UPLOAD_RATE_LIMIT_PER_MINUTE=10
OFFICIAL_PAYMENT_RATE_LIMIT_PER_MINUTE=30

# Paystack — platform purchases only. Start with TEST keys; switch to live keys
# only at the approved go-live gate. Webhook (set in the Paystack dashboard):
#   https://api.marcaturshub.com.ng/api/v1/webhooks/paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
# Leave empty: browser return URLs are built from FRONTEND_URL. Never the webhook URL.
PAYSTACK_CALLBACK_URL=

# Resend (API transport, resend/resend-php). Sender domain must be verified in Resend.
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=no-reply@marcaturshub.com.ng
MAIL_FROM_NAME="${APP_NAME}"
# Optional; no Reply-To header when unset.
MAIL_REPLY_TO_ADDRESS=
MAIL_REPLY_TO_NAME=
