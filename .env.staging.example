############################################
# MarcatursHub — STAGING environment template
# ENG-040A / MH-OPS-001
#
# Copy to a secret store / local .env.staging (NEVER commit real values).
# APP_ENV must remain "staging". Never point at production credentials.
############################################

APP_NAME=MarcatursHub
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.staging.example.com
FRONTEND_URL=https://app.staging.example.com
ADMIN_URL=https://admin.staging.example.com

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=marcaturshub_staging
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.staging.example.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=reverb
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379

# Private object storage (TAD §9). Buckets must NOT be public.
FILESYSTEM_DISK=local
SENSITIVE_DISK_DRIVER=s3
CAMPAIGN_MEDIA_DISK_DRIVER=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=
SENSITIVE_AWS_BUCKET=
CAMPAIGN_MEDIA_AWS_BUCKET=
SENSITIVE_S3_ROOT=sensitive
CAMPAIGN_MEDIA_S3_ROOT=campaign-media
AWS_USE_PATH_STYLE_ENDPOINT=false

# Paystack TEST mode only — never production secret keys in staging.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=https://api.staging.example.com/api/v1/webhooks/paystack

# Controlled staging mail (SES / SMTP). Do not use MAIL_MAILER=log for UAT email verification.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=noreply@staging.example.com
MAIL_FROM_NAME="${APP_NAME} Staging"

# Reverb — explicit origins only (no wildcard in staging).
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=ws.staging.example.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=https://app.staging.example.com,https://admin.staging.example.com
# Application-layer HSTS (API must be HTTPS). Edge HSTS may also be set on CloudFront/ALB.
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000

SANCTUM_STATEFUL_DOMAINS=app.staging.example.com,admin.staging.example.com,api.staging.example.com
SANCTUM_TOKEN_EXPIRATION_MINUTES=10080
CORS_ALLOWED_ORIGINS=https://app.staging.example.com,https://admin.staging.example.com

API_VERSION=v1
API_RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=5
REGISTRATION_RATE_LIMIT_PER_MINUTE=5
PASSWORD_RESET_RATE_LIMIT_PER_MINUTE=5
EMAIL_VERIFICATION_RATE_LIMIT_PER_MINUTE=5
UPLOAD_RATE_LIMIT_PER_MINUTE=10
OFFICIAL_PAYMENT_RATE_LIMIT_PER_MINUTE=30

CAMPAIGN_MEDIA_DISK=campaign_media
VERIFICATION_EVIDENCE_DISK=sensitive
DEAL_PAYMENT_EVIDENCE_DISK=sensitive

# Container entrypoint: set true only on a single API task startup / release job.
RUN_MIGRATIONS=false
